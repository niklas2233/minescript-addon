{
  "schemaVersion": 1,
  "id": "minescriptaddon",
  "version": "${version}",
  "name": "Minescript Addon",
  "description": "Lets Minescript scripts draw text, boxes and items on the HUD.",
  "authors": ["niklas2233"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.niklas2233.minescriptaddon.MinescriptHud"]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": ">=26.1 <27",
    "java": ">=25",
    "fabric-api": "*"
  },
  "recommends": {
    "minescript": "*"
  }
}
