{
  "schemaVersion": 1,
  "id": "minescriptaddon",
  "version": "${version}",
  "name": "Minescript Addon",
  "description": "Gives Minescript scripts a HUD, every chat line (including the action bar and lines other mods add), hotkeys, alerts, inputs that let go when a script dies, and client ticks.",
  "authors": ["niklas2233"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.niklas2233.minescriptaddon.MinescriptHud", "com.niklas2233.minescriptaddon.MinescriptChat", "com.niklas2233.minescriptaddon.MinescriptKeys", "com.niklas2233.minescriptaddon.MinescriptInputs", "com.niklas2233.minescriptaddon.MinescriptTicks"]
  },
  "mixins": ["minescriptaddon.mixins.json", "minescriptaddon.overlay.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": ">=26.1 <27",
    "java": ">=25",
    "fabric-api": "*"
  },
  "recommends": {
    "minescript": "*"
  }
}
